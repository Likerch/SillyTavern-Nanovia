{
  "name": "sillytavern-nanovia",
  "version": "0.0.1",
  "private": true,
  "description": "NanoGPT for SillyTavern: connections with OpenRouter-style routing, billing awareness, a catalog, usage and a local proxy plugin",
  "license": "AGPL-3.0-only",
  "author": "Likerchik",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "mock": "node tools/mock-nanogpt/server.mjs",
    "deploy:local": "node scripts/deploy-local.mjs",
    "stand": "node tools/stand/stand.mjs",
    "stand:stop": "node tools/stand/stand.mjs stop",
    "fixtures:refresh": "node tools/fixtures/refresh.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.0.0",
    "lodash": "^4.17.21",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
